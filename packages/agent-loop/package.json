{
  "name": "dsh-gungnir-loop",
  "version": "0.1.0",
  "description": "Gungnir Adaptive Loop Runtime — a drop-in replacement driver for the DSH default agent loop. Lock the goal. Adapt the loop. Prove the hit. (ADR-0012; internal package name @gungnir/agent-loop, npm release name candidate dsh-gungnir-loop.)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "gungnir-core": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../deepseek-harness-dsh-v0.1.2-alpha.1/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../deepseek-harness-dsh-v0.1.2-alpha.1/packages/core/agent",
    "@deepseek-ai/dsh-llm": "link:../../deepseek-harness-dsh-v0.1.2-alpha.1/packages/llm/llm",
    "@deepseek-ai/dsh-scope": "link:../../deepseek-harness-dsh-v0.1.2-alpha.1/packages/core/scope",
    "@deepseek-ai/dsh-session": "link:../../deepseek-harness-dsh-v0.1.2-alpha.1/packages/core/session",
    "@deepseek-ai/dsh-session-persistence": "link:../../deepseek-harness-dsh-v0.1.2-alpha.1/packages/session/session-persistence",
    "@deepseek-ai/dsh-system-prompt": "link:../../deepseek-harness-dsh-v0.1.2-alpha.1/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../../deepseek-harness-dsh-v0.1.2-alpha.1/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../../deepseek-harness-dsh-v0.1.2-alpha.1/vendor/schemastery",
    "vitest": "^3.2.4"
  }
}
