ep (in loadFlags or inside the matcher) lowercases, trims, or joins the segment collections into a single string before comparison, so an exact per-element equality check never happens and substring hits (e.g. 'beta' inside a joined 'beta-testers staff') are possible."],"recommended_next_action":"Fix the confirmed root cause (src/segments.js) under src/ per the README spec, then run the test suite to verify."},"telemetry":{"branch":{"phases":[{"phase":"enumerate","ms":61867,"hypotheses":4},{"phase":"investigate","ms":63380,"branches":4,"reportsParsed":4},{"phase":"converge+handoff","ms":125247,"selected":"h1","packetBytes":2228}],"packetBytes":2228,"totalMs":125247,"selectionReason":"rank confirmed>inconclusive, then evidence count; selected h1 (confirmed, 3 evidence items)"},"handoff":{"packetBytes":2228,"packetFields":["goal_spec","goal_status","selected_hypothesis","verified_facts","evidence_refs","artifact_refs","unresolved_questions","recommended_next_action"]},"usage":{"inputTokens":80811,"outputTokens":13818,"cachedTokens":59392,"requests":34,"retries":0,"errors":0}},"verify":{"verdict":"PASS","gates":{"bugNotReproducible":{"ok":true,"exitCode":0,"output":"original bug not reproducible\n"},"trunkTestsPass":{"ok":true,"exitCode":0,"counts":{"tests":11,"pass":11,"fail":0},"tail":"TAP version 13\n# Subtest: flags: segment membership decides over rollout, by exact match only\nok 1 - flags: segment membership decides over rollout, by exact match only\n  ---\n  duration_ms: 1.7254\n  type: 'test'\n  ...\n# Subtest: flags: exact segment match enables\nok 2 - flags: exact segment match enables\n  ---\n  duration_ms: 0.151\n  type: 'test'\n  ...\n# Subtest: flags: rollout bucket decides without segments\nok 3 - flags: rollout bucket decides without segments\n  ---\n  duration_ms: 0.1566\n  type: 'test'\n  ...\n# Subtest: flags: rollout honours the pinned bucket of the user\nok 4 - flags: rollout honours the pinned bucket of the user\n  ---\n  duration_ms: 0.1666\n  ty